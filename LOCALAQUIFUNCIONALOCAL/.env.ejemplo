# Configuracion LOCAL de AURA (sin pod, sin GPU, sin Ollama). Solo usa OpenAI.
# INICIAR.bat copia este archivo a ".env" la primera vez y rellena las dos claves.
# El archivo ".env" NO se sube a git (esta ignorado). Nunca compartas tu clave.

# Clave de acceso LOCAL entre la pagina y el servidor. La genera INICIAR.bat; no es la de OpenAI.
API_KEY=

# Tu clave de OpenAI (empieza con sk-). Si esta vacia, INICIAR.bat te la pide una sola vez.
OPENAI_API_KEY=

AURA_PIPELINE=hybrid
AURA_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini

# Sin Ollama: la nube hace todo. Si OpenAI falla, el usuario ve un error (no hay lectura de respaldo).
AURA_DETECTOR=off
AURA_FALLBACK=off
AURA_WARMUP=off

# Sin la voz en ingles del servidor (Piper): AURA usa la voz del navegador.
AURA_TTS=off

AURA_RATE_LIMIT_PER_MIN=60
# Tope de paginas que se mandan a OpenAI por dia, para cuidar el saldo (0 = sin tope).
AURA_CLOUD_MAX_PAGES_PER_DAY=0
