# Backend FastAPI + Ollama (flujo principal)
API_KEY=replace_with_a_long_random_secret
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl
MAX_CACHE_ENTRIES=128

# Frontend. En produccion, configura estas variables en Vercel.
VITE_API_URL=http://localhost:3001
VITE_API_KEY=replace_with_the_same_api_key

# Backend Node/Groq legado (server.js)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b
PORT=3001
