# Backend FastAPI + Ollama (flujo principal)
API_KEY=replace_with_a_long_random_secret
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl
MAX_CACHE_ENTRIES=128

# Frontend local. No configures estas variables en el frontend de produccion.
VITE_API_URL=http://localhost:3001
VITE_API_KEY=replace_with_the_same_api_key

# Proxy privado de Vercel. Configura estas dos variables solo en el servidor.
AURA_BACKEND_URL=https://api.example.com
AURA_API_KEY=replace_with_the_same_api_key
