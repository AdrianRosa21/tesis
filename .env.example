# Backend FastAPI (flujo principal)
API_KEY=replace_with_a_long_random_secret
# Clave para ver los logs en vivo (public/debug.html). Si no se pone, se usa API_KEY.
# LOGS_STREAM_KEY=otra_clave_distinta
MAX_CACHE_ENTRIES=128
MAX_IMAGE_SIZE_MB=5
# Peticiones por minuto por persona (0 = sin limite)
AURA_RATE_LIMIT_PER_MIN=30

# --- Motor de IA ---------------------------------------------------------------
# hybrid = un modelo en la nube lee la pagina y Ollama solo detecta que contiene (y es el respaldo).
# v4 / v3 = todo con Ollama (sin enviar paginas a terceros).
# Si eliges hybrid pero no pones la clave de la nube, el backend usa v4 automaticamente.
AURA_PIPELINE=hybrid
# Proveedor en la nube: gemini | openai
AURA_PROVIDER=gemini
# Detector local (Ollama clasifica la pagina en paralelo): ollama | off
AURA_DETECTOR=ollama
# Si la nube falla, repetir la pagina con Ollama: ollama | off
AURA_FALLBACK=ollama

# Pon SOLO la clave del proveedor que uses. Nunca subas este archivo a git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# auto | off | numero de tokens de razonamiento (auto desactiva el razonamiento en 2.5 Flash)
GEMINI_THINKING=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Segundos maximos que se espera a la nube antes de usar el respaldo
AURA_CLOUD_TIMEOUT_S=60

# --- Ollama (detector y respaldo) -----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl
# Ventana de contexto de Ollama (evita que recorte el prompt)
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m
# Cargar el modelo local al arrancar (en segundo plano) para que la primera pagina no pague ~85 s de carga: on | off
AURA_WARMUP=on
# Llamadas extra cuando falta describir una imagen/grafica/diagrama
AURA_MAX_FOLLOWUPS=1
# Cloudflare corta cerca de 100 s: cada pagina debe terminar antes de este presupuesto
AURA_TIME_BUDGET_S=80
# Donde se guarda el historial de logs (sobrevive a reinicios si esta en /workspace)
# LOG_FILE_PATH=/workspace/aura/logs/backend.log

# Frontend local. No configures estas variables en el frontend de produccion.
VITE_API_URL=http://localhost:3001
VITE_API_KEY=replace_with_the_same_api_key

# Proxy privado de Vercel. Configura estas dos variables solo en el servidor.
AURA_BACKEND_URL=https://api.example.com
AURA_API_KEY=replace_with_the_same_api_key
